{
    "author": "Jurand Niemczycki <createdbyjurand@gmail.com>",
    "description": "@createdbyjurand",
    "devDependencies": {
        "@types/node": "26.6.4",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-markdown": "5.1.0",
        "eslint-plugin-node": "11.1.0",
        "nodemon": "3.1.14",
        "prettier": "3.9.9",
        "rimraf": "6.1.3",
        "typescript": "7.0.2",
        "vite": "8.3.4",
        "vitest": "5.0.3"
    },
    "license": "ISC",
    "name": "@createdbyjurand",
    "private": true,
    "scripts": {
        "cloak : build": "cd cloak && rimraf dist && tsc",
        "cloak : publish": "npm publish ./cloak --access public --tag latest",
        "node-scripts : nodemon time and date": "nodemon node node-scripts/@shared/time-and-date.node.mjs",
        "node-scripts : publish": "cd node-scripts && npm publish --access public --tag latest",
        "node-scripts : rebuild @shared module": "node node-scripts/bin/rebuild-modules.node.mjs --path=node-scripts/@shared --extension=node.mjs",
        "node-scripts : update release version": "node node-scripts/bin/update-release-version.node.mjs --patch --pr",
        "outdated": "npm outdated",
        "status-codes : publish": "cd status-codes && npm publish --access public --tag latest",
        "status-codes : rebuild": "cd status-codes && rimraf dist && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && tsc -p tsconfig.types.json",
        "test": "vitest run",
        "test : watch": "vitest",
        "update-dependencies": "node node-scripts/bin/update-dependencies.node.mjs --all --remove-prefixes",
        "update-dependencies-lpd": "node node-scripts/bin/update-dependencies.node.mjs --all --remove-prefixes --legacy-peer-deps"
    },
    "type": "module",
    "version": "1.0.0-SNAPSHOT"
}
